FROM python@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/nexus
COPY vendor /opt/vendor
COPY nexus_api /opt/nexus/nexus_api
COPY api_entrypoint.py /opt/nexus/api_entrypoint.py
USER 10001:10001
ENTRYPOINT ["python", "-I", "/opt/nexus/api_entrypoint.py"]
