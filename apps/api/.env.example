NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
# Provision independent credentials first; these placeholders are not usable defaults.
NEXUS_DATABASE_URL=postgresql+psycopg://nexus_api:replace-me@127.0.0.1:55432/nexus
NEXUS_MIGRATION_DATABASE_URL=postgresql+psycopg://nexus_migrator:replace-me@127.0.0.1:55432/nexus
NEXUS_PROVISIONER_DATABASE_URL=postgresql+psycopg://nexus_provisioner:replace-me@127.0.0.1:55432/nexus
NEXUS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Explicit opt-in: seed demo users only in development. Production rejects true.
NEXUS_DEMO_AUTH_ENABLED=false
NEXUS_COOKIE_SECURE=false
NEXUS_SESSION_TTL_SECONDS=28800
NEXUS_LOGIN_ATTEMPT_LIMIT=8
NEXUS_LOGIN_PEER_LIMIT=120
NEXUS_LOGIN_WINDOW_SECONDS=300

# Public trust metadata only. Set from an independently reviewed public keyring.
NEXUS_PROOF_TRUSTED_KEYS={}
